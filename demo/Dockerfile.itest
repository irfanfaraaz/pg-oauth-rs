# Integration-test runner: libpq 18 from the same pinned Postgres image, Rust, and the docker CLI
# (the tests stop/start Keycloak and read the Postgres log). Build context is the repo root.
# Tests are compiled here, so `docker compose run itest` only runs them. See demo/run-itests.sh.

# Only for its static docker CLI binary.
FROM docker:29.9.0-cli AS docker-cli

FROM postgres:18.6-trixie

# libpq-dev must match the installed libpq5 exactly (both from the PGDG repo in this image).
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential pkg-config curl ca-certificates \
        "libpq-dev=$(dpkg-query -W -f='${Version}' libpq5)"; \
    rm -rf /var/lib/apt/lists/*

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH

WORKDIR /itest

# The same pinned toolchain as the module (rust-toolchain.toml), and the committed Cargo.lock.
COPY rust-toolchain.toml ./
RUN set -eux; \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain none; \
    rustup toolchain install

COPY tests/itest/ ./
RUN cargo test --locked --no-run

# compose.yaml sets the entrypoint (trust the demo CA) and the command (cargo test, serially).
